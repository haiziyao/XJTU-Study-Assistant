{
  "name": "xjtu-study-assistant",
  "version": "0.2.0",
  "private": true,
  "description": "AI 智学程序：框架（src/core）+ 可插拔功能模块（src/modules）。Node.js 零依赖后端 + Electron/浏览器测试窗口",
  "type": "module",
  "main": "src/main/main.cjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:server": "node --watch bin/server.js",
    "start:server": "node bin/server.js",
    "dev:app": "electron .",
    "dev:app:macos": "bash scripts/run-electron-macos.sh",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "study-assistant",
    "calendar",
    "schedule",
    "lms",
    "electron",
    "ai-tutor"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^44.7.0"
  }
}
