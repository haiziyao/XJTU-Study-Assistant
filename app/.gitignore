# 依赖与构建产物
node_modules/
dist/
out/

# 本地 Electron 测试窗口包（由 scripts/run-electron-macos.sh 生成，含 130MB 运行时）
.electron-bundle/

# 运行时数据（本地用户数据，不入库；损坏备份一并忽略）
# `data/` 整个目录都是运行时的：除了 *.json，还有 OCR 编译缓存（data/.ocr/，首次用 swiftc 编译产物）
# 与将来可能落地的图片/附件目录 —— 一律不入库，别只挡住 *.json 让缓溜进来。
data/
data/*.json
data/*.corrupt-*
data/*.tmp
data/*.pid

# 服务端版（公开网页）的运行时数据：账号库 + 每用户数据目录。**绝不入库**。
# 这里面有：users.json（密码哈希与 salt）、sessions.json（活的会话令牌）、invites.json，
# 以及 users/<userId>/ 下每个账号自己的对话/笔记/日程/AI key —— 一次误提交等于把所有账号交出去。
data-www/
data-www/**

# 本地凭据与侦察产物：绝不入库
# （敏感串本身从不写进任何文件，这里是防止有人手工把凭据/会话存到仓库里）
*credential*
*probe-session*
*.local.json

# 系统与编辑器
.DS_Store
*.log
.idea/
.vscode/
